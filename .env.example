# Seals the session cookie. Fill this with 32+ random characters before starting.
# See README "Run it" for a command that creates .env without printing the password.
NUXT_SESSION_PASSWORD=
# Model: mock (recorded fixtures, default) or meta (Meta Model API)
NUXT_MODEL_MODE=mock
NUXT_MODEL_ID=muse-spark-1.3
NUXT_IMAGE_MODEL_ID=muse-image-1.0
NUXT_META_API_KEY=

# Seals the session cookie. 32+ random characters, e.g. `openssl rand -base64 32`. In dev, nuxt-auth-utils writes one to .env if missing.
NUXT_SESSION_PASSWORD=
# Model: mock (recorded fixtures, default) or meta (Meta Model API)
NUXT_MODEL_MODE=mock
NUXT_MODEL_ID=muse-spark-1.3
NUXT_META_API_KEY=
# Staging (storybible.trythis.work): the same four keys live in the secret store secret/staging, see deployment/README.md
